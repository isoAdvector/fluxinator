#!/bin/bash
#------------------------------------------------------------------------------
# Removes the logs written by Allrun (data/ is tracked in git and kept).
# ./Allclean -scans also deletes the study directories run by Allrun.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
rm -rf __pycache__
rm -f log.analyseScan_* log.writeData
if [ "$1" = "-scans" ]
then
    rm -rf solvers_maxCo solvers_fixedDt nLayers_maxCo baseCaseNLayers
fi
#------------------------------------------------------------------------------
