// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

/*
DebugSwitches
{
    cyclic                 2;
}
*/

application     interIsoGoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         30;

writeControl    timeStep;

writeInterval   1e6;

deltaT          0.001;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression no;

timeFormat      general;

timePrecision   6;

graphFormat     raw;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.2;

maxAlphaCo      $maxCo;

maxDeltaT       0.2;

functions
{
    interfaceHeight1
    {
        type            interfaceHeight;
        libs            ( fieldFunctionObjects );
        locations       ( ( 1.0001 0.0001 0.0001 ) );
        alpha           alpha.water;
        direction       ( 0 0 1 );
        writeControl    timeStep;
        writeInterval   1;
    }

    fieldMinMax1
    {
        type            fieldMinMax;
        libs            ( fieldFunctionObjects );
        writeToFile     yes;
        mode            magnitude;
        fields          ( U );
        location        no;
        writeControl    timeStep;
        writeInterval   1;
    }
/*
    surfaces
    {
        type            surfaces;
        libs            (geometricVoF sampling);
        writeControl    writeTime;

        surfaceFormat   vtp;
        fields          (p U);

        interpolationScheme cell;

        surfaces
        {
            freeSurf
            {
                type            reconstructedInterface;
                interpolate     false;
            }
        }
    }
*/
}


