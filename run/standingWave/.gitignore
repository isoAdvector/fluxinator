# Case directories generated by paperScan.sh; the .csv summaries under scan/
# are the data the paper cites and are kept
scan/*/

# Cases run by hand for the experiments in experiments/FINDINGS.md
baseCase/[0-9]*/
basic/[0-9]*/
uncorrected/[0-9]*/
densWei/[0-9]*/
*/postProcessing/
log.*

# snapshots.sh: keep only the fields plotSnapshots.py reads
snapshots/*/*
!snapshots/*/0.590909/
!snapshots/*/1.181817/
snapshots/*/0.590909/*
snapshots/*/1.181817/*
!snapshots/*/0.590909/U
!snapshots/*/0.590909/alpha.water
!snapshots/*/1.181817/U
!snapshots/*/1.181817/alpha.water
!snapshots/interIsoGoam/0/
snapshots/interIsoGoam/0/*
!snapshots/interIsoGoam/0/Cx
!snapshots/interIsoGoam/0/Cz
!snapshots/interIsoGoam/0/V

# Generated by figure.sh; syncFigures.sh copies the pdf into the paper's
# figures/ directory
snapshots/*.png
snapshots/log.*
figure_standingWave.pdf
figure_standingWave.aux

# Meshes are made by Allrun; ParaView state and LaTeX by-products
*/constant/polyMesh/
*.pvsm
*.aux
*.log
