FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     interFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          0.01;

writeControl    timeStep;

writeInterval   20;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1e+06;

functions
{
    surfacePosition1
    {
        type            surfacePosition;
        libs            ( surfacePosition );
        errors          strict;      // stop if the library is not installed
        locations       ( ( 0.001 0 0.5001 ) );
        alpha           alpha.water;
        direction       ( 0 0 -1 );
        writeControl    timeStep;
        writeInterval   1;
    }
    fieldMinMax1
    {
        type            fieldMinMax;
        libs            ( fieldFunctionObjects );
        writeToFile     yes;
        mode            magnitude;
        fields          ( U );
        location        no;
        writeControl    timeStep;
        writeInterval   1;
    }
}


