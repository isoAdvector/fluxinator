#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove logs; keep the studies
#   ./Allclean -scans   # also delete the study directories
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -f log.writeData
# data/ is tracked in git and kept

if [ "$1" = "-scans" ]
then
    rm -rf gravityModels_1step gravityModels_100steps gravityModels_1000steps \
        meshTimeStep_1step airDensity_1000steps nLayers_1000steps baseCaseNLayers
else
    echo "Study directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
