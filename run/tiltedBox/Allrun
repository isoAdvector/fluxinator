#!/bin/bash
#------------------------------------------------------------------------------
# Runs the tilted box scans and generates the paper figures.
#
# Requirements: OpenFOAM v2512 environment with interIsoGoam and libgravityModels
# built (../../Allwmake), cfdTools, pvpython (ParaView) on PATH for the per-case
# velocity images (baseCase/Allrun calls it), pdflatex, and python3 with numpy
# and matplotlib. Environment variables: CFDTOOLS (path to cfdTools/cfdTools),
# MAXJOBS (number of simultaneous cases, default nproc).
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

cfdTools=${CFDTOOLS:-../../../cfdTools/cfdTools}
[ -f "$cfdTools" ] || { echo "cfdTools not found at $cfdTools; set CFDTOOLS" >&2; exit 1; }
[ -n "$WM_PROJECT_DIR" ] || { echo "Source the OpenFOAM environment first" >&2; exit 1; }
command -v pvpython > /dev/null || echo "Warning: pvpython not found; case images will be missing" >&2
source "$cfdTools"
maxJobs=${MAXJOBS:-$(nproc)}

for scan in \
    gravityModelScan_1deltaT \
    gravityModelScan_100deltaT \
    gravityModelScan_1000deltaT \
    deltaTScan \
    airDensityScan_1000deltaT \
    nLayersScan
do
    parmScanner -file "$scan.csv" -exec Allrun -parallel -maxJobs "$maxJobs"
done

# Geometric gravity model with nLayers 0, 1 and 2
python3 ../summariseScan.py nLayersScan | tee summary_nLayersScan.txt

# Velocity fields after 1, 100 and 1000 time steps (gravityRecon column omitted)
pdflatex -interaction=nonstopmode figure_paper.tex > log.figure_paper 2>&1

# Maximum velocity against time, against the time step (first step) and against air density
python3 plotMaxU.py > log.plotMaxU 2>&1
python3 plotFirstStepMaxU.py > log.plotFirstStepMaxU 2>&1
python3 plotMaxUvsRhoAir.py > log.plotMaxUvsRhoAir 2>&1

echo "Figures: figure_paper.pdf, maxU_tiltedBox.pdf, firstStepMaxU_tiltedBox.pdf, maxUvsRhoAir_tiltedBox.pdf"

#------------------------------------------------------------------------------
