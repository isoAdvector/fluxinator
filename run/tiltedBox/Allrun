#!/bin/bash
#------------------------------------------------------------------------------
# Runs the tilted box studies and writes their summaries to data/.
# The paper figures and tables are made in papers/part1/{fig,tab}_* (make.py).
#
# Requirements: OpenFOAM v2512 environment with interIsoGoam and libgravityModels
# built (../../Allwmake), cfdTools, pvpython (ParaView) on PATH for the per-case
# velocity images (baseCase/Allrun calls it), and python3 with numpy.
# Environment variables: CFDTOOLS (path to cfdTools/cfdTools),
# MAXJOBS (number of simultaneous cases, default nproc).
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

cfdTools=${CFDTOOLS:-../../../cfdTools/cfdTools}
[ -f "$cfdTools" ] || { echo "cfdTools not found at $cfdTools; set CFDTOOLS" >&2; exit 1; }
[ -n "$WM_PROJECT_DIR" ] || { echo "Source the OpenFOAM environment first" >&2; exit 1; }
command -v pvpython > /dev/null || echo "Warning: pvpython not found; case images will be missing" >&2
source "$cfdTools"
maxJobs=${MAXJOBS:-$(nproc)}

../common/makeNLayersBase.sh baseCase baseCaseNLayers
for study in \
    gravityModels_1step \
    gravityModels_100steps \
    gravityModels_1000steps \
    meshTimeStep_1step \
    airDensity_1000steps \
    nLayers_1000steps
do
    parmScanner -file "$study.csv" -exec Allrun -parallel -maxJobs "$maxJobs"
    ../common/runDdtCorrOffStudy.sh "$study"    # Part I, Appendix A
done

python3 writeData.py > log.writeData 2>&1

#------------------------------------------------------------------------------
