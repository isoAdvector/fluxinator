#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove summaries; keep the scans
#   ./Allclean -scans   # also delete the scan directories
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -f summary_*.txt log.snGradRhoReach log.renderSnGradReach log.plotNonOrthMaxU log.checkMesh
# paperData/ is tracked in git and kept
rm -rf paperFigures
rm -f figure_tiltedBoxRefined.pdf figure_tiltedBoxRefined.aux figure_tiltedBoxRefined.log \
    log.figure_tiltedBoxRefined
rm -f ../nonOrthMaxU_skewBox.pdf ../nonOrthMaxU_skewBox.png
rm -f ../nonOrthMaxU_refined.pdf ../nonOrthMaxU_refined.png

if [ "$1" = "-scans" ]
then
    rm -rf zeroStartScan hydrostaticInitScan nLayersZeroStartScan nLayersHydrostaticScan
else
    echo "Scan directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
