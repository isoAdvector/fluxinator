#!/bin/bash
#------------------------------------------------------------------------------
# Runs the refined tilted box tests of corrected schemes, hydrostatic
# initialisation and the nLayers option of the geometric gravity model, and
# prints summaries.
#
# Requirements: OpenFOAM v2512 environment with interIsoGoam and libgravityModels
# built (../../Allwmake), cfdTools, pvpython (ParaView) on PATH for the per-case
# images (baseCase/Allrun calls it) and python3. Environment variables:
# CFDTOOLS (path to cfdTools/cfdTools), MAXJOBS (default nproc).
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

cfdTools=${CFDTOOLS:-../../../cfdTools/cfdTools}
[ -f "$cfdTools" ] || { echo "cfdTools not found at $cfdTools; set CFDTOOLS" >&2; exit 1; }
[ -n "$WM_PROJECT_DIR" ] || { echo "Source the OpenFOAM environment first" >&2; exit 1; }
source "$cfdTools"
maxJobs=${MAXJOBS:-$(nproc)}

for scan in zeroStartScan hydrostaticInitScan nLayersZeroStartScan nLayersHydrostaticScan
do
    parmScanner -file "$scan.csv" -exec Allrun -parallel -maxJobs "$maxJobs"
done

# Numbers behind the paper (tracked in git): one summary per scan
mkdir -p paperData
for scan in zeroStartScan hydrostaticInitScan nLayersZeroStartScan nLayersHydrostaticScan
do
    python3 ../summariseScan.py "$scan" > "paperData/$scan.txt"
done

# Cells adjacent to faces with non-zero uncorrected and corrected snGrad(rho)
postProcess -case zeroStartScan/0000 -time 0 -dict "$(pwd)/../snGradRhoReach" \
    > log.snGradRhoReach 2>&1
grep snGradReach log.snGradRhoReach > paperData/snGradRhoReach.txt

# Mesh quality
checkMesh -case zeroStartScan/0000 -time 0 > log.checkMesh 2>&1
sed -n '/Mesh stats/,/End/p' log.checkMesh > paperData/checkMesh.txt

# Location of the maximum velocity with nLayers 1 from a hydrostatic start
python3 maxUCellRing.py > paperData/maxUCellRing.txt

# Paper figures: reach and velocity fields (pvbatch), and max|U| per time step
# for this case and the skewed box (needs the scans in ../skewBox)
pvbatch=${PVBATCH:-pvbatch}
"$pvbatch" --force-offscreen-rendering renderSnGradReach.py > log.renderSnGradReach 2>&1

# Velocity collage of the hydrostatic start cases
for c in hydrostaticInitScan/0004 hydrostaticInitScan/0002 hydrostaticInitScan/0000 \
    nLayersHydrostaticScan/0001
do
    ( cd "$c" && "$pvbatch" --force-offscreen-rendering generateFigure.py > log.generateFigure 2>&1 )
done
pdflatex -interaction=nonstopmode figure_tiltedBoxRefined.tex > log.figure_tiltedBoxRefined 2>&1
python3 ../plotNonOrthMaxU.py > log.plotNonOrthMaxU 2>&1

#------------------------------------------------------------------------------
