#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

restore0Dir

caseName=$(basename $(dirname $(readlink -f "$0")))
touch ${caseName}.foam

runApplication blockMesh

# Refine a square region intersecting the water line (split 2x2 in x and z)
runApplication -s 1 topoSet -dict system/topoSetDict1
runApplication -s 1 refineMesh -dict system/refineMeshDict1 -overwrite

runApplication transformPoints -centre '(.5 0 .5)' -rotate-y $(foamDictionary -entry rotAngle rotAngleDict -value)

runApplication setAlphaField

runApplication $(getApplication)

#runApplication foamSequenceVTKFiles -vtp

pvpython generateFigure.py

#------------------------------------------------------------------------------
