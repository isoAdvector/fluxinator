#!/bin/bash
#------------------------------------------------------------------------------
# Runs the fixed-dt and fixed-maxCo scans of the periodic stream function wave
# and generates the metrics and paper figures.
#
# Usage:
#   ./Allrun                    # run (or complete) both scans, then post-process
#   ./Allrun -postProcessOnly   # only post-process existing scans
#
# Requirements: OpenFOAM v2512 environment with interIsoGoam and libgravityModels
# built (../../Allwmake), streamFunFoam (see README), cfdTools, python3 with
# numpy, scipy and matplotlib, and pvbatch (ParaView) for the case illustration.
# Environment variables: CFDTOOLS (path to cfdTools/cfdTools), MAXJOBS (number
# of simultaneous cases, default nproc), PVBATCH (default pvbatch).
#
# Note: the full scans take several days; parmScanner skips cases that have
# already been run, so an interrupted scan can be completed by rerunning.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

maxJobs=${MAXJOBS:-$(nproc)}
pvbatch=${PVBATCH:-pvbatch}

if [ "$1" != "-postProcessOnly" ]
then
    cfdTools=${CFDTOOLS:-../../../cfdTools/cfdTools}
    [ -f "$cfdTools" ] || { echo "cfdTools not found at $cfdTools; set CFDTOOLS" >&2; exit 1; }
    [ -n "$WM_PROJECT_DIR" ] || { echo "Source the OpenFOAM environment first" >&2; exit 1; }
    source "$cfdTools"

    parmScanner -file gravityModelScanParms.csv -exec Allrun -parallel -maxJobs "$maxJobs"
    parmScanner -file gravityModelScanParms_fixedDt.csv -exec Allrun -parallel -maxJobs "$maxJobs"
fi

# Accuracy and efficiency metrics per run
python3 analyseScan.py --scanDir gravityModelScan --csv maxCoMetrics.csv > log.analyseScan_maxCo 2>&1
python3 analyseScan.py --scanDir gravityModelScan_fixedDt --csv fixedDtMetrics.csv > log.analyseScan_fixedDt 2>&1

# Paper figures
python3 paperFigures.py > log.paperFigures 2>&1

# Numbers and appendix tables behind the paper (tracked in git)
python3 paperData.py > log.paperData 2>&1

if command -v "$pvbatch" > /dev/null
then
    "$pvbatch" --force-offscreen-rendering renderCaseIllustration.py \
        --transparent --out paperFigures/caseIllustration.png > log.renderCaseIllustration 2>&1
else
    echo "pvbatch not found: case illustration not rendered" >&2
fi

echo "Metrics: maxCoMetrics.csv, fixedDtMetrics.csv. Figures: paperFigures/. Data: paperData/"

#------------------------------------------------------------------------------
