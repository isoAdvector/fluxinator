#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove metrics, figures and logs; keep the scans
#   ./Allclean -scans   # also delete the scan directories (tens of GB, days to rerun)
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -rf paperFigures __pycache__
rm -f maxCoMetrics.csv fixedDtMetrics.csv
rm -f log.analyseScan_maxCo log.analyseScan_fixedDt log.paperFigures log.renderCaseIllustration

if [ "$1" = "-scans" ]
then
    rm -rf gravityModelScan gravityModelScan_fixedDt
else
    echo "Scan directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
