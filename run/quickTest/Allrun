# Quick test of fluxinator of Part II, a few minutes on one core. Copies two stored
# cases to this directory, runs them and prints the results next to the expected values:
#   disc: the accelerated disc of Part II, Section 4 (needs only ../../Allwmake)
#   wave: one period of the progressive wave, 190x40, fixed dt 0.01 s (needs streamFunFoam)
cd "${0%/*}" || exit 1
[ -n "${WM_PROJECT_DIR:-}" ] || { echo "Source an OpenFOAM environment first" >&2; exit 1; }
type dictator > /dev/null 2>&1 || { echo "Source dictator first (github.com/isoAdvector/dictator)" >&2; exit 1; }
# Copies a stored case without results, to run with fluxinator and its defaults
# and without the wave gauge, which needs surfacePosition and is not checked here
copyCase() {
    mkdir "$2" && cp -r "$1"/{0.orig,constant,system,Allrun} "$2"/
    rm -rf "${2:?}"/constant/polyMesh
    {
    dictator "$2"/system/fvSolution PIMPLE.explicitConvection -delete &&
    dictator "$2"/system/fvSolution PIMPLE.ddtCorr -delete &&
    for f in "$2"/system/controlDict "$2"/system/controlDict.run
    do
        [ -f "$f" ] || continue
        dictator "$f" application fluxinator || exit 1
        if grep -q surfacePosition1 "$f"
        then
            dictator "$f" functions.surfacePosition1.enabled false || exit 1
        fi
    done
    } > "$2"/log.dictator || exit 1
}

rm -rf disc wave
copyCase ../periodicDisc/explicitLWIU_rhoNew disc
disc/Allrun > disc/log.Allrun 2>&1
if type streamFunFoam > /dev/null 2>&1
then
    copyCase ../progressiveWave/convection/explicitLWIU_190x40_dt0.01 wave
    dictator wave/system/controlDict.run endTime 2 >> wave/log.dictator || exit 1
    wave/Allrun > wave/log.Allrun 2>&1
else
    echo "streamFunFoam not found: wave case skipped"
fi
python3 check.py
