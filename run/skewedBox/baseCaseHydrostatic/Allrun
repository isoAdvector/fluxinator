#!/bin/bash
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
type dictator > /dev/null 2>&1 || { echo "Source dictator first (github.com/isoAdvector/dictator)" >&2; exit 1; }
#------------------------------------------------------------------------------

restore0Dir

caseName=$(basename $(dirname $(readlink -f "$0")))
touch ${caseName}.foam

runApplication blockMesh

angle=$(dictator rotAngleDict rotAngle) || exit 1
runApplication transformPoints -centre '(.5 0 .5)' -rotate-y $angle

runApplication setAlphaField

# Hydrostatic initial p_rgh consistent with the initial volume fraction
runApplication setHydrostaticPressure

runApplication $(getApplication)

