FoamFile { version 2.0; format ascii; class dictionary; object fvOptions; }

// Uniform body acceleration a = (0.5 0 0) m/s^2 of the accelerated-disc test:
// momentum source rho*a with the density at the new time level.
bodyAcceleration
{
    type            vectorCodedSource;
    selectionMode   all;
    fields          (U);
    name            bodyAcceleration;

    codeCorrect     #{ #};
    codeAddSup      #{ #};
    codeConstrain   #{ #};

    codeAddSupRho
    #{
        eqn += rho*dimensionedVector(dimAcceleration, vector(0.5, 0, 0));
    #};
}
