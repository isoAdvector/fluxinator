#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove figure, summaries and logs; keep the scans
#   ./Allclean -scans   # also delete the scan directories
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -f figure_skewBox.pdf figure_skewBox.aux figure_skewBox.log log.figure_skewBox
rm -f summary_*.txt

if [ "$1" = "-scans" ]
then
    rm -rf skewBoxScan_z skewBoxScan nonOrthCorrScan hydrostaticInitScan nLayersDefaultScan
else
    echo "Scan directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
