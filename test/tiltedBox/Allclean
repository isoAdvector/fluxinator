#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove figures and logs; keep the scans
#   ./Allclean -scans   # also delete the scan directories
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -f figure_paper.pdf figure_paper.aux figure_paper.log
rm -f maxU_tiltedBox.pdf maxU_tiltedBox.png
rm -f firstStepMaxU_tiltedBox.pdf firstStepMaxU_tiltedBox.png
rm -f maxUvsRhoAir_tiltedBox.pdf maxUvsRhoAir_tiltedBox.png
rm -f log.figure_paper log.plotMaxU log.plotFirstStepMaxU log.plotMaxUvsRhoAir

if [ "$1" = "-scans" ]
then
    rm -rf gravityModelScan_1deltaT gravityModelScan_100deltaT gravityModelScan_1000deltaT \
        deltaTScan airDensityScan_1000deltaT
else
    echo "Scan directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
