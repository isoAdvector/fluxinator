#!/bin/bash
#------------------------------------------------------------------------------
# Removes the files generated by Allrun.
#
# Usage:
#   ./Allclean          # remove summaries; keep the scans
#   ./Allclean -scans   # also delete the scan directories
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

rm -f summary_*.txt

if [ "$1" = "-scans" ]
then
    rm -rf zeroStartScan hydrostaticInitScan nLayersZeroStartScan nLayersHydrostaticScan
else
    echo "Scan directories kept; use ./Allclean -scans to delete them as well"
fi

#------------------------------------------------------------------------------
